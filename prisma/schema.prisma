generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id                 String              @id @default(uuid())
  name               String
  type               String              // Standard, Deluxe, Suite, Villa
  description        String              @db.Text
  maxAdults          Int
  maxChildren        Int
  basePrice          Decimal             @db.Decimal(10, 2)
  totalUnits         Int
  amenities          String[]
  images             String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  pricingRules       RoomPricingRule[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]
  reservationLocks   ReservationLock[]
}

model RoomPricingRule {
  id         String    @id @default(uuid())
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id])
  ruleType   String    // seasonal, weekend, los
  startDate  DateTime?
  endDate    DateTime?
  multiplier Decimal   @db.Decimal(5, 2)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AvailabilityBlock {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String
  createdBy String   // User ID
  createdAt DateTime @default(now())
}

model Booking {
  id                   String              @id @default(uuid())
  confirmationNumber   String              @unique
  roomId               String
  room                 Room                @relation(fields: [roomId], references: [id])
  guestId              String
  guest                Guest               @relation(fields: [guestId], references: [id])
  checkIn              DateTime
  checkOut             DateTime
  adults               Int
  children             Int
  totalPrice           Decimal             @db.Decimal(10, 2)
  status               String              // PENDING, CONFIRMED, FAILED, CANCELLED, REFUNDED
  cancellationPolicyId String
  cancellationPolicy   CancellationPolicy  @relation(fields: [cancellationPolicyId], references: [id])
  specialRequests      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  payment              Payment?
  reservationLock      ReservationLock?
}

model Guest {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String    
  phone     String
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Payment {
  id               String    @id @default(uuid())
  bookingId        String    @unique
  booking          Booking   @relation(fields: [bookingId], references: [id])
  gateway          String    // PAYSTACK, STRIPE
  gatewayReference String?   @unique
  amount           Decimal   @db.Decimal(10, 2)
  currency         String    @default("NGN")
  status           String    // PENDING, PROCESSING, SUCCESS, FAILED, REFUNDED
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  refunds          Refund[]
}

model Refund {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  reason      String
  status      String   // PENDING, PROCESSED, FAILED
  processedBy String?  // User ID
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model ReservationLock {
  id           String   @id @default(uuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id])
  sessionToken String
  bookingId    String?  @unique
  booking      Booking? @relation(fields: [bookingId], references: [id])
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([roomId, sessionToken])
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    // RECEPTIONIST, MANAGER, ADMIN
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  diff       Json
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model CancellationPolicy {
  id        String    @id @default(uuid())
  name      String
  rules     Json
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}
